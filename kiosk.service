[Unit]
Description=Chromium Kiosk for ESP32 dashboard
After=graphical.target read_esp32.service
Wants=graphical.target read_esp32.service

[Service]
Type=simple
User=orangepi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/orangepi/.Xauthority
WorkingDirectory=/home/orangepi
ExecStart=/bin/bash /home/orangepi/read_esp32/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
